node_modules/
dist/

# Real env files (secrets + per-dataset config) — never commit these.
# .env.example is a template and IS meant to be committed.
.env
.env.*
!.env*.example

# Scraped/generated output, per dataset (data/<dataset>/jobs.sqlite etc.)
data/**/*.json
data/**/*.sqlite
data/**/*.sqlite-shm
data/**/*.sqlite-wal
data/**/*.xlsx
!data/**/.gitkeep

# Prompts can contain personal info (candidate-profile.txt) — keep out of git.
prompts/*
